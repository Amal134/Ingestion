HADOOP_HOME=/opt/hadoop

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=root

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.webhdfs.enabled=true

HDFS-SITE.XML_dfs.permissions.enabled=false

HDFS-SITE.XML_dfs.datanode.hostname=localhost
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true

# CONTREPARTIE de ces deux lignes : tout client situe DANS le reseau docker
# se voit lui aussi rediriger vers "localhost", qui chez lui ne designe pas le
# datanode. Consequences concretes :
#   - `docker exec namenode hdfs dfs -cat ...`  -> Connection refused
#   - `docker exec datanode hdfs dfs -cat ...`  -> fonctionne (localhost = lui)
#   - WebHDFS / Python depuis la machine hote   -> fonctionne
#
# Cette configuration cible donc l'execution des notebooks DEPUIS L'HOTE.
# Pour tout executer dans docker (service `jupyter` du compose), remplacer
# `localhost` par `datanode` ci-dessus : la redirection devient resolvable
# dans le reseau docker, mais plus depuis Windows.
